    "keywords": [
        "Validator",
        "schema"
    ],
    "homepage": "https://github.com/svinx-org/validator",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "EORBAH",
            "email": "eor.bah545@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/svinx-org/validator/issues",
